        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="rank" target="quality"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="quality" target="expand"><mxGeometry relative="1" as="geometry"/></mxCell>
