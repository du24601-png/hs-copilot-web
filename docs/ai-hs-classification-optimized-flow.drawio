        <mxCell id="e22" value="更新上下文并重新分析/检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1D4ED8;" edge="1" parent="1" source="userAnswer" target="semantic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="2000"/><mxPoint x="1250" y="520"/><mxPoint x="900" y="520"/></Array></mxGeometry></mxCell>
