        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="structured" target="objectAmbiguous"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1D4ED8;fontStyle=1;" edge="1" parent="1" source="objectAmbiguous" target="clarifyObject"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="用户回答后重新理解" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1D4ED8;" edge="1" parent="1" source="clarifyObject" target="semantic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="815"/><mxPoint x="380" y="520"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="objectAmbiguous" target="searchPlan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="searchPlan" target="retrieve"><mxGeometry relative="1" as="geometry"/></mxCell>
