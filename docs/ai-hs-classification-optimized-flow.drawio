<mxfile host="app.diagrams.net" modified="2026-09-02T16:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="ai-hs-flow" name="优化后的AI归类流程">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="2350" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="HS Copilot｜优化后的 AI 动态归类流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#172554;fontColor=#FFFFFF;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="AI 先理解与规划检索，数据库提供权威事实；信息不足时按答案动态追问，而非固定问 1～2 题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#818CF8;fontColor=#312E81;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="1220" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="principles" value="&lt;b&gt;产品原则&lt;/b&gt;&lt;br&gt;① AI：理解、歧义识别、检索规划、动态追问&lt;br&gt;② 数据库：编码、税率、监管条件、申报要素&lt;br&gt;③ 每轮只问最能缩小候选的问题&lt;br&gt;④ 结论编码必须命中数据库候选&lt;br&gt;⑤ 达到轮次上限仍不可靠则人工复核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;颜色说明&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot;&gt;■ 用户输入/回答&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7C3AED&quot;&gt;■ AI 理解与推理&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;■ 数据库检索/回查&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;◆ 判断与停止条件&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;■ 低置信度/人工复核&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="930" y="180" width="300" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="用户输入商品描述&lt;br&gt;&lt;b&gt;例：吸管不锈钢保温杯&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="190" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="isCode" value="是否为 10 位&lt;br&gt;HS 编码？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="525" y="310" width="250" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="directVerify" value="数据库直接核验编码&lt;br&gt;返回名称、税率、监管条件、申报要素" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="325" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="directOutput" value="输出编码核验结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="455" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="semantic" value="&lt;b&gt;AI 语义理解&lt;/b&gt;&lt;br&gt;识别申报对象、主体、功能、材质、结构、附件与用户已知信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="440" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="structured" value="生成结构化商品理解&lt;br&gt;&lt;b&gt;主体：保温饮水容器｜功能：真空保温&lt;br&gt;材质：不锈钢｜附件：吸管｜备选解释：单独吸管&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="610" width="440" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="objectAmbiguous" value="申报对象是否&lt;br&gt;存在关键歧义？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="525" y="755" width="250" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="clarifyObject" value="向用户先确认申报对象&lt;br&gt;&lt;b&gt;完整保温杯，还是单独吸管？&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="searchPlan" value="&lt;b&gt;AI 生成税则检索计划&lt;/b&gt;&lt;br&gt;给出 1～3 个商品解释与税则概念&lt;br&gt;例：保温瓶｜真空容器｜不锈钢制器具｜吸管" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="910" width="440" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="retrieve" value="&lt;b&gt;数据库多路召回&lt;/b&gt;&lt;br&gt;正式税则名称｜同义词/税则词典｜CIQ 俗名&lt;br&gt;品目注释/全文索引｜编码前缀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="1060" width="440" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="rank" value="合并、去重与候选重排&lt;br&gt;优先匹配商品主体和主要功能，材质与附件作为约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontColor=#14532D;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="1215" width="440" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="quality" value="候选是否包含合理方向&lt;br&gt;且相关性达标？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="525" y="1340" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="expand" value="AI 扩展税则语言&lt;br&gt;补充上位词、近义词、功能词和备选商品解释" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1350" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="expandLimit" value="扩展检索是否&lt;br&gt;少于 2 次？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="75" y="1490" width="230" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="manual" value="低置信度/拒答&lt;br&gt;说明缺少的信息与已排查方向&lt;br&gt;&lt;b&gt;建议上传规格书、图片或人工复核&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1640" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="compare" value="&lt;b&gt;AI 比较真实候选的分歧点&lt;/b&gt;&lt;br&gt;判断还缺哪些会改变税目的关键属性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="1505" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="enough" value="现有信息是否足以&lt;br&gt;稳定确定候选？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="525" y="1640" width="250" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="roundLimit" value="是否仍在提问上限内？&lt;br&gt;建议最多 5 轮或 6 个问题" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="950" y="1645" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="nextQuestion" value="AI 只生成下一道最高信息量问题&lt;br&gt;&lt;b&gt;例：杯体是否具有双层真空结构？&lt;/b&gt;&lt;br&gt;可选择“不确定”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="1810" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="userAnswer" value="用户回答问题&lt;br&gt;系统保存答案并更新已知属性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="930" y="1960" width="300" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="decide" value="&lt;b&gt;AI 基于候选与全部答案作出预归类判断&lt;/b&gt;&lt;br&gt;输出候选编码、置信度、理由、反事实与备选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="1815" width="440" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="sanitize" value="&lt;b&gt;安全钳制 + 数据库回查&lt;/b&gt;&lt;br&gt;编码必须命中候选；名称、税率、监管条件、申报要素全部由数据库覆盖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="1965" width="440" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="输出 AI 预归类建议&lt;br&gt;&lt;b&gt;推荐编码｜置信度｜归类依据｜备选方向｜人工复核提示&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="2110" width="440" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="declaration" value="进入申报信息补全阶段&lt;br&gt;品牌、型号、容量等不影响归类的信息在编码确定后再收集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="2245" width="440" height="80" as="geometry"/>
        </mxCell>
