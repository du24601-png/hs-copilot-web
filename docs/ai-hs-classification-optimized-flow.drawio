        <mxCell id="e4" value="否：自然语言描述" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="isCode" target="semantic"><mxGeometry relative="1" as="geometry"/></mxCell>
