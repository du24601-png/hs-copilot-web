        <mxCell id="e15" value="是：带扩展词重搜" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#166534;" edge="1" parent="1" source="expandLimit" target="retrieve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="1540"/><mxPoint x="380" y="1115"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B91C1C;fontStyle=1;" edge="1" parent="1" source="expandLimit" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="quality" target="compare"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="compare" target="enough"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontColor=#92400E;fontStyle=1;" edge="1" parent="1" source="enough" target="roundLimit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="roundLimit" target="nextQuestion"><mxGeometry relative="1" as="geometry"/></mxCell>
