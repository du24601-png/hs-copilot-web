        <mxCell id="e6" value="再查一次" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="retry" target="search"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="490"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="coverage" target="difference"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="difference" target="ask"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="带着答案重新判断" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="ask" target="understand"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="25" y="810"/><mxPoint x="25" y="245"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="没有" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="difference" target="choose"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="choose" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="verify" target="reliable"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="reliable" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="reliable" target="human"><mxGeometry relative="1" as="geometry"/></mxCell>
