<mxfile host="app.diagrams.net" modified="2026-09-02T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="hs-ai-simple" name="AI 原生 HS 归类改造流程">
    <mxGraphModel dx="1200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AI 原生 HS 归类：从“猜关键词”升级为“理解—检查—再判断”" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="205" y="20" width="690" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="① 用户描述真实商品" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="90" width="370" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="understand" value="② AI 先理解商品&#xa;主体是什么 · 主要功能 · 工作原理 · 关键结构 · 明确排除项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="200" width="370" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="plan" value="③ AI 翻译成税则语言&#xa;给出上位名称 + 可能的 4 位品目方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="330" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="search" value="④ 数据库多路查找&#xa;商品原词 + 税则词 + 4 位品目内查找" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="450" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="coverage" value="⑤ AI 检查：&#xa;正确方向真的在候选里吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="580" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="retry" value="换成更上位的说法&#xa;只重搜 1 次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="595" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="difference" value="⑥ 候选之间还有会改变编码的关键差异吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="750" width="260" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="ask" value="只问 1 个最关键问题&#xa;用户回答后重新理解&#xa;最多 3 轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="765" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="choose" value="⑦ AI 只从真实候选中选择&#xa;同时说明为什么选、什么情况下会改变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="920" width="370" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="⑧ 数据库做最后核对&#xa;编码存在 · 品名 · 税率 · 申报要素" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="1045" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="reliable" value="信息足够、结果可靠吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="1170" width="260" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="输出预归类建议&#xa;编码 + 理由 + 官方依据 + 仍需确认项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="1320" width="370" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="human" value="安全拒答 / 人工复核&#xa;说明缺什么资料，不硬猜编码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="1180" width="240" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="bottom" value="底线不变：AI 负责理解与判断；数据库负责真实编码；不确定时允许拒答。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="1450" width="580" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="input" target="understand"><mxGeometry relative="1" as="geometry"/></mxCell>
