<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-02T17:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="beginner-flow" name="AI归类流程-初学者汇报版">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="HS Copilot｜AI 智能归类流程（汇报简明版）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="AI 负责听懂用户在说什么、想办法查找、按需提问；数据库保证编码和税率真实可靠" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="105" width="1170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="roles" value="&lt;b&gt;AI 和数据库各做什么？&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6D28D9&quot;&gt;&lt;b&gt;AI：&lt;/b&gt;理解商品、换成海关常用说法、判断还缺什么信息、提出问题&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;&lt;b&gt;数据库：&lt;/b&gt;提供真实编码、商品名称、税率、监管条件和申报要素&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#334155;fontSize=14;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="35" y="195" width="290" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="askRule" value="&lt;b&gt;提问原则&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 信息清楚：可以不问&lt;br&gt;• 信息模糊：每次只问一个最关键的问题&lt;br&gt;• 根据上一个答案决定下一题&lt;br&gt;• 建议最多 5 轮&lt;br&gt;• 仍无法确定：提示人工确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;fontColor=#7C2D12;fontSize=14;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="925" y="195" width="290" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;1　用户描述商品&lt;/b&gt;&lt;br&gt;例：吸管不锈钢保温杯" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="190" width="410" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="understand" value="&lt;b&gt;2　AI 先理解这句话&lt;/b&gt;&lt;br&gt;商品：保温杯｜材质：不锈钢｜附件：吸管｜功能：保温" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="310" width="410" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="clearObject" value="用户说的是哪件商品&lt;br&gt;已经清楚了吗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="505" y="445" width="240" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="clarify" value="先向用户确认&lt;br&gt;&lt;b&gt;申报完整保温杯，还是单独的吸管？&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="455" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="taxWords" value="&lt;b&gt;3　AI 想出海关可能使用的名称&lt;/b&gt;&lt;br&gt;“保温杯”可能叫：保温瓶、真空容器、保温容器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="610" width="410" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="search" value="&lt;b&gt;4　用多种说法查数据库&lt;/b&gt;&lt;br&gt;同时查商品名称、俗称、用途和相关说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="750" width="410" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="found" value="有没有找到看起来&lt;br&gt;正确的商品方向？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="505" y="880" width="240" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="retry" value="AI 换一种海关常用说法再找&lt;br&gt;建议最多尝试 2 次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="890" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="manual" value="仍然找不到或信息不足&lt;br&gt;&lt;b&gt;请用户补充图片、规格书，或转人工确认&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="1040" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="checkMissing" value="&lt;b&gt;5　AI 看看还缺哪些关键信息&lt;/b&gt;&lt;br&gt;只关注“答案不同会不会改变编码”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="1040" width="410" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="enough" value="现在的信息够不够&lt;br&gt;判断编码方向？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="505" y="1170" width="240" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="oneQuestion" value="&lt;b&gt;6　只问当前最关键的一个问题&lt;/b&gt;&lt;br&gt;例：杯体是否具有双层真空结构？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="925" y="1175" width="290" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="answer" value="用户回答后&lt;br&gt;AI 重新理解并再次查找" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="925" y="1325" width="290" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="choose" value="&lt;b&gt;7　AI 从真实候选中提出建议&lt;/b&gt;&lt;br&gt;说明为什么选、还有哪些备选、把握有多大" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="1335" width="410" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="&lt;b&gt;8　数据库做最后核对&lt;/b&gt;&lt;br&gt;确认编码真实存在，并补上名称、税率和监管信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="1475" width="410" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="result" value="&lt;b&gt;9　向用户展示预归类建议&lt;/b&gt;&lt;br&gt;推荐编码｜理由｜可信程度｜备选方向｜人工复核提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="1615" width="410" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="declaration" value="&lt;b&gt;10　编码确定后，再补充申报信息&lt;/b&gt;&lt;br&gt;品牌、型号、容量等信息放在最后填写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="1755" width="410" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="input" target="understand"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="understand" target="clearObject"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="不清楚" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1D4ED8;fontStyle=1;" edge="1" parent="1" source="clearObject" target="clarify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="回答后重新理解" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1D4ED8;" edge="1" parent="1" source="clarify" target="understand"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="500"/><mxPoint x="375" y="355"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="清楚" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="clearObject" target="taxWords"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="taxWords" target="search"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="search" target="found"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="没有" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="found" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="换词后再查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#166534;" edge="1" parent="1" source="retry" target="search"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="375" y="935"/><mxPoint x="375" y="795"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="多次查找仍失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontColor=#B91C1C;" edge="1" parent="1" source="retry" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="找到了" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="found" target="checkMissing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="checkMissing" target="enough"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="还不够" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1D4ED8;fontStyle=1;" edge="1" parent="1" source="enough" target="oneQuestion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="oneQuestion" target="answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="带着新信息重新开始" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1D4ED8;" edge="1" parent="1" source="answer" target="understand"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1205" y="1365"/><mxPoint x="1205" y="355"/><mxPoint x="875" y="355"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="足够" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;fontColor=#5B21B6;fontStyle=1;" edge="1" parent="1" source="enough" target="choose"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="choose" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F766E;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="verify" target="result"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="result" target="declaration"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
